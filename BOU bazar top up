<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BOU BAZAR TOP UP</title>
<style>
body{font-family:Arial;background:#111;color:white;text-align:center;margin:0;}
h1{color:#00ffd5;margin-top:20px;}
.section{background:#222;margin:15px;padding:15px;border-radius:10px;}
.packages{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.package{background:#333;padding:12px;border-radius:8px;cursor:pointer;}
.package.selected{border:2px solid #00ffd5;}
input{padding:10px;border:none;border-radius:6px;margin:5px;width:80%;}
button{padding:10px;border:none;background:#00ffd5;border-radius:6px;font-weight:bold;cursor:pointer;}
.copy{background:red;color:white;}
.price{font-size:18px;margin-top:10px;}
</style>
</head>
<body>

<h1>💎 BOU BAZAR TOP UP</h1>

<!-- Player -->
<div class="section">
<h3>🎮 Player UID</h3>
<input type="text" id="playerID" placeholder="Player ID লিখুন">
</div>

<!-- Special Packages -->
<div class="section">
<h3>🔥 Special Packages</h3>
<div class="packages">
<div class="package" onclick="selectPackage(this,'UCL Light',1)">UCL Light<br>1 TK</div>
<div class="package" onclick="selectPackage(this,'UCL',10)">UCL<br>10 TK</div>
<div class="package" onclick="selectPackage(this,'Matli',660)">Matli<br>660 TK</div>
<div class="package" onclick="selectPackage(this,'উকলি লাইট',38)">উকলি লাইট<br>38 TK</div>
<div class="package" onclick="selectPackage(this,'উকলি',150)">উকলি<br>150 TK</div>
<div class="package" onclick="selectPackage(this,'মাতলি',750)">মাতলি<br>750 TK</div>
</div>
</div>

<!-- Diamond Packages -->
<div class="section">
<h3>💎 Diamond Packages</h3>
<div class="packages">
<div class="package" onclick="selectPackage(this,'25 Diamond',22)">25 💎<br>22 TK</div>
<div class="package" onclick="selectPackage(this,'50 Diamond',39)">50 💎<br>39 TK</div>
<div class="package" onclick="selectPackage(this,'115 Diamond',75)">115 💎<br>75 TK</div>
<div class="package" onclick="selectPackage(this,'240 Diamond',150)">240 💎<br>150 TK</div>
<div class="package" onclick="selectPackage(this,'355 Diamond',240)">355 💎<br>240 TK</div>
<div class="package" onclick="selectPackage(this,'610 Diamond',380)">610 💎<br>380 TK</div>
<div class="package" onclick="selectPackage(this,'1270 Diamond',420)">1270 💎<br>420 TK</div>
</div>
</div>

<!-- Evo Gun -->
<div class="section">
<h3>🔥 Evo Gun</h3>
<div class="packages">
<div class="package" onclick="selectEvo(this,'3 Days - 70 TK')">3 Days<br>70 TK</div>
<div class="package" onclick="selectEvo(this,'7 Days - 85 TK')">7 Days<br>85 TK</div>
<div class="package" onclick="selectEvo(this,'10 Days - 100 TK')">10 Days<br>100 TK</div>
<div class="package" onclick="selectEvo(this,'30 Days - 330 TK')">30 Days<br>330 TK</div>
<div class="package" onclick="selectEvo(this,'60 Days - 660 TK')">60 Days<br>660 TK</div>
</div>
<p id="evoText">None</p>
</div>

<!-- Level Up Pass -->
<div class="section">
<h3>🎟 Level Up Pass</h3>
<div class="packages">
<div class="package" onclick="selectLevel(this,'10 Level - 70 TK')">10 Level</div>
<div class="package" onclick="selectLevel(this,'15 Level - 70 TK')">15 Level</div>
<div class="package" onclick="selectLevel(this,'20 Level - 70 TK')">20 Level</div>
<div class="package" onclick="selectLevel(this,'25 Level - 70 TK')">25 Level</div>
<div class="package" onclick="selectLevel(this,'30 Level - 100 TK')">30 Level</div>
<div class="package" onclick="selectLevel(this,'Full Pass - 420 TK')">Full Pass</div>
</div>
<p id="levelText">None</p>
</div>

<!-- Payment -->
<div class="section">
<h3>💳 Payment</h3>
<p>Number: <b id="number">01851634841</b> <button class="copy" onclick="copyNumber()">Copy</button></p>
<input type="text" id="txnID" placeholder="Transaction ID দিন">
</div>

<!-- Order -->
<div class="section">
<button onclick="sendOrder()">Order Now</button>
</div>

<script>
let selectedPackage="", selectedPrice=0;
let selectedEvo="", selectedLevel="";

// Package selection
function selectPackage(el,name,price){
document.querySelectorAll(".package").forEach(p=>p.classList.remove("selected"));
el.classList.add("selected");
selectedPackage=name;
selectedPrice=price;
document.getElementById("priceDisplay")?.remove();
let div=document.createElement("div");
div.id="priceDisplay";
div.innerHTML=`Selected: ${name} - ${price} TK`;
el.parentNode.appendChild(div);
}

// Evo Gun selection
function selectEvo(el,val){
document.querySelectorAll("#evoText").forEach(p=>p.classList.remove("selected"));
el.classList.add("selected");
selectedEvo=val;
document.getElementById("evoText").innerText=val;
}

// Level Pass selection
function selectLevel(el,val){
document.querySelectorAll("#levelText").forEach(p=>p.classList.remove("selected"));
el.classList.add("selected");
selectedLevel=val;
document.getElementById("levelText").innerText=val;
}

// Copy number
function copyNumber(){
navigator.clipboard.writeText(document.getElementById("number").innerText);
alert("Number Copied");
}

// Send order
function sendOrder(){
let player=document.getElementById("playerID").value;
let txn=document.getElementById("txnID").value;
if(player=="" || txn==""){
alert("সব তথ্য দিন");
return;
}
let message=`🔥 NEW ORDER 🔥
Player ID: ${player}
Package: ${selectedPackage}
Evo Gun: ${selectedEvo}
Level Pass: ${selectedLevel}
Transaction ID: ${txn}`;
let phone="8801851634841";
let url="https://wa.me/"+phone+"?text="+encodeURIComponent(message);
window.open(url,"_blank");
}
</script>

</body>
</html>
